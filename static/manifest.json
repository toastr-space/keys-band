{
	"manifest_version": 3,
	"name": "Keys.Band",
	"version": "1.6.0",
	"description": "Nostr Nip07 implementation",
	"minimum_chrome_version": "111",
	"action": {
		"default_popup": "popup.html"
	},
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"icons": {
		"16": "assets/logo-on.png",
		"32": "assets/logo-on.png",
		"48": "assets/logo-on-64.png",
		"128": "assets/logo-on-64.png"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": ["storage", "scripting", "tabs", "sidePanel"],
	"host_permissions": ["https://*/*", "http://*/*", "<all_urls>"],
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"],
			"run_at": "document_start"
		},
		{
			"matches": ["<all_urls>"],
			"js": ["assets/nostr-provider.js"],
			"run_at": "document_start",
			"world": "MAIN"
		}
	],
	"content_security_policy": {
		"extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self'; connect-src 'self' wss: ws:; base-uri 'none'; form-action 'none'"
	}
}
